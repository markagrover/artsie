# API / unified host
# Copy to apps/api/.env and fill in local values. Never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/artsie
# Generate a long random string for local JWT signing, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to use an ephemeral secret for this process only.
JWT_SECRET=
PORT=4000
# Leave empty for same-origin (published / unified). Set for split Vite+API local:
# CORS_ORIGIN=http://localhost:5173

# Storage: "local" (default) or "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3-compatible (when STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=artsie-artwork
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://artsie-artwork.s3.amazonaws.com

# Web (Vite split-dev only — leave unset for same-origin unified host)
# VITE_API_URL=http://localhost:4000
