{
  "name": "artsie",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @artsie/api",
    "dev:web": "npm run dev -w @artsie/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @artsie/api",
    "db:seed": "npm run db:seed -w @artsie/api"
  },
  "engines": {
    "node": ">=20"
  }
}
